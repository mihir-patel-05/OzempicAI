# Web service: serves the built PWA from /srv and forwards /api to the API
# service over Railway's private network (same origin, so no CORS and no
# build-time API URL).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# Browser security headers, on every response (pages and API alike).
	header {
		# Never render this app inside another site's frame. A framed consent
		# screen could be dressed up to trick someone into pressing Allow.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# Browsers remember to use https only, for a year.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Addresses here can carry OAuth parameters; don't hand them to other sites.
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# The coach's chat endpoint streams server-sent events; compressing it
	# would buffer tokens into bursts, so it is left out of encode and proxied
	# without buffering.
	@compressible not path /api/ai/chat
	encode @compressible zstd gzip

	handle /api/ai/chat {
		reverse_proxy {$API_UPSTREAM:localhost:8787} {
			flush_interval -1
		}
	}

	# OAuth discovery for AI apps connecting to /api/mcp. Without this route
	# these would fall through to the SPA and return index.html.
	handle /.well-known/oauth-* {
		reverse_proxy {$API_UPSTREAM:localhost:8787}
	}

	handle /api/* {
		# e.g. http://api.railway.internal:8080 (API_UPSTREAM on the web service)
		reverse_proxy {$API_UPSTREAM:localhost:8787}
	}

	handle {
		root * /srv

		# Hashed bundles never change; everything else (index.html, sw.js,
		# manifest, icons) is revalidated so installed PWAs pick up new deploys.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		# BrowserRouter deep links fall back to the SPA shell.
		try_files {path} /index.html
		file_server
	}
}
