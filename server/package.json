{
  "name": "ozempic-ai-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "migrate:dev": "tsx --env-file-if-exists=.env src/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "import:supabase": "node dist/import-supabase.js",
    "smoke:ai": "tsx --env-file-if-exists=.env src/ai/smoke.ts",
    "invite": "tsx --env-file-if-exists=.env src/invite.ts",
    "vapid:keys": "tsx src/push/vapid-keys.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "3.6.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
