# Copy to server/.env and fill in for local development (npm run dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ozempicai
# Local machines without IPv6 need this; Railway uses the default (::).
HOST=0.0.0.0
PORT=8787

# New accounts: open or closed. Unset means closed when NODE_ENV=production and
# open otherwise. Sign-up does not verify email addresses yet, so leave it
# closed in production unless you are deliberately onboarding people.
# SIGNUP_MODE=open

# Password reset email via Resend (optional locally).
# RESEND_API_KEY=
# EMAIL_FROM=OzempicAI <no-reply@your-domain.com>
# APP_URL=http://localhost:5173

# AI coach (optional). Without ANTHROPIC_API_KEY, /api/ai/* returns 503 and the
# rest of the app keeps working.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_MAX_TURNS_PER_HOUR=40
# Across all users: coach messages per hour, and turns running at once.
# AI_MAX_TURNS_PER_HOUR_TOTAL=300
# AI_MAX_CONCURRENT_TURNS=8

# Connect your own AI (MCP + OAuth, docs/mcp-server-plan.md). Needs APP_URL,
# the public origin serving the web app (http://localhost:5173 locally, where
# Vite proxies /api and /.well-known/oauth-* to this server).
# MCP_ENABLED=true
