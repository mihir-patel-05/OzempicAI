# Copy to server/.env and fill in for local development (npm run dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ozempicai
# Local machines without IPv6 need this; Railway uses the default (::).
HOST=0.0.0.0
PORT=8787

# Password reset email via Resend (optional locally).
# RESEND_API_KEY=
# EMAIL_FROM=OzempicAI <no-reply@your-domain.com>
# APP_URL=http://localhost:5173

# AI coach (optional). Without ANTHROPIC_API_KEY, /api/ai/* returns 503 and the
# rest of the app keeps working.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_MAX_TURNS_PER_HOUR=40
