# Copy to .env.local and fill in. .env.local is gitignored.
# Point at local Docker Supabase (http://localhost:8000) for dev,
# or your hosted project for production. Use only a public publishable/anon key;
# never place a secret or service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
